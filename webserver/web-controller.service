[Unit]
Description=Robot web web-controller service
Requires=robot.service
After=robot.service

[Service]
WorkingDirectory=/home/ubuntu/mini_pupper_web_controller/webserver/backend/backend
ExecStart=/usr/bin/taskset -c 0,1 /usr/bin/env web-controller
Restart=on-failure
KillSignal=2
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
